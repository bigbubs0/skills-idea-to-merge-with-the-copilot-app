---
import Base from '../layouts/Base.astro';
import Bookmarks from '../components/Bookmarks.astro';
---
<Base title="Mona's Bookmark Manager App">
  <header>
    <h1>🔖 Mona's Bookmark Manager App</h1>
    <p class="tagline">Your useful links, all in one place. Save a URL with a short <code>mona-</code> alias.</p>
  </header>

  <main>
    <Bookmarks />
  </main>

  <footer>
    Saved in this browser. No account needed. Slugs are local labels, not shortened links.
  </footer>
</Base>
